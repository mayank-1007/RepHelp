# Neon Postgres Database
DATABASE_URL="postgresql://username:password@your-neon-host/your-database?sslmode=require"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email Configuration (Nodemailer with Gmail)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-specific-password"

# Twilio Configuration (for SMS/OTP - optional)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Admin Access
NEXT_PUBLIC_ADMIN_PASSKEY="your-admin-passkey"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
